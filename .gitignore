*.elc
*.eln
/eln-cache/

# Per-checkout Claude Code state: machine-specific absolute paths
# (statusLine command) and live process locks (PID/session-id/timestamp) —
# never meaningful outside the machine that created them.
/.claude/

# Git worktrees created under the checkout. Not ignored until 2026-09-10, so a
# `git add -A` staged them as embedded git repositories (they are real repos).
/.worktrees/

# matrix-bridge runtime/test artifacts: bridge.log and media/ are created
# by both the live service and `python3 test_bridge.py` (its own tempdir
# is used for synthetic fixtures, but downloaded/queued audio still lands
# under matrix-bridge/media -- see bridge.py's MEDIA_DIR).
/matrix-bridge/bridge.log
/matrix-bridge/media/
/matrix-bridge/__pycache__/
